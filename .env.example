# Copy to .env and fill in. Everything is optional: with no keys SkyGuard runs
# offline (mock VLM + deterministic SOP rules planner).

# --- Groq (free tier): https://console.groq.com/keys -------------------------
# Enables BOTH the vision model and the reasoning LLM. Groq rotates its catalogue;
# list what your key can use with:  python -m skyguard.cli --list-groq-models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VLM_MODEL=qwen/qwen3.8-27b

# auto = groq if GROQ_API_KEY is set, else offline fallback
LLM_PROVIDER=auto          # groq | ollama | rules | auto
VLM_BACKEND=auto           # groq | qwen_local | hf_api | mock | auto
# Tiled small-object inference (full frame + 4 zoomed tiles = 5 VLM calls per frame).
# Leave off on Groq's free tier (8k tokens/min/model; one image ~2.4k tokens).
VLM_TILING=off

# --- Local options ------------------------------------------------------------
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
QWEN_LOCAL_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# --- Hugging Face Inference Providers (optional): https://huggingface.co/settings/tokens
HF_TOKEN=
HF_VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# --- RAG ----------------------------------------------------------------------
RAG_BACKEND=auto           # chroma | keyword | auto
RAG_TOP_K=4

# --- Observability: LangSmith free tier: https://smith.langchain.com ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skyguard
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Or Arize Phoenix (100% local): pip install -r requirements-optional.txt, then `phoenix serve`
PHOENIX_ENABLED=false
